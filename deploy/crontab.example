# KOSPI Swing Scanner 자동화 스케줄
# VM에서 적용: crontab -e 로 아래 내용 붙여넣기
# 주의: VM 시간대가 KST(Asia/Seoul)인지 확인 → timedatectl set-timezone Asia/Seoul

# ─── Prerequisites ───────────────────────────────────────────────────────────
# weights.yml ($APP_DIR/weights.yml) 이 존재해야 신호별 후회값(regret score)이
# signals.json 에 포함됩니다. 없으면 ranking.decision 필드가 null 로 출력됩니다.
# 최초 배포 시: python cli.py --interview  → weights.yml 생성
# 이후 git pull 로 weights.yml 이 배포되므로 별도 실행 불필요.
# ─────────────────────────────────────────────────────────────────────────────

APP_DIR=/opt/apps/kospi-scanner
VENV_PYTHON=/opt/apps/kospi-scanner/.venv/bin/python
LOG_DIR=/opt/apps/logs/kospi-scanner/
LOCK=/tmp/kospi-scanner.lock

# Job A: 장 마감 후 OHLCV 수집 (평일 16:10 KST)
10 16 * * 1-5 cd $APP_DIR && $VENV_PYTHON scripts/collect.py --market KOSPI --cache-root .cache >> $LOG_DIR/collect.log 2>&1

# Job B + E: 일봉 신호 생성 성공 직후 최근 6개월 전략 성과 갱신 (평일 16:40 KST)
# 같은 flock 안의 && 체인이므로 Job B 실패 시 Job E는 실행되지 않음.
# weights.yml 존재 시 → 모든 종목 regret score 계산 후 signals.json 에 포함 + ranking_report.md 생성
40 16 * * 1-5 cd $APP_DIR && flock -n $LOCK sh -c "([ -f weights.yml ] || echo '[WARNING] weights.yml 없음 → 후회값 미계산' >> $LOG_DIR/signals.log) && $VENV_PYTHON cli.py --strategy all --cache-root .cache --output-dir data --format signals_ui >> $LOG_DIR/signals.log 2>&1 && $VENV_PYTHON scripts/aggregate_strategy_performance.py --data-dir data --cache-root .cache --output data/strategy_performance.json >> $LOG_DIR/performance.log 2>&1"

# Job C30 (장중 1h 신호): 30분 간격 collect(1h) → cli 페어링
# flock -n: 이미 실행 중이면 skip (Job B14와 충돌 방지)
# weights.yml 존재 시 후회값 자동 계산 (signals.json ranking.decision.max_regret)
1,31 9-15 * * 1-5 cd $APP_DIR && flock -n $LOCK sh -c "$VENV_PYTHON scripts/collect.py --market KOSPI --cache-root .cache --timeframes 1h >> $LOG_DIR/collect_intraday.log 2>&1 && $VENV_PYTHON cli.py --strategy all --cache-root .cache --output-dir data --format signals_ui >> $LOG_DIR/signals_intraday.log 2>&1"

# Job B14 (14:00 1D 포함 전체 갱신): 오늘 14:00 현재가를 1D close로 반영
# smart-skip 없이 1D 강제 갱신. flock으로 C30(14:01)과 직렬화
# weights.yml 존재 시 후회값 자동 계산 (signals.json ranking.decision.max_regret)
0 14 * * 1-5 cd $APP_DIR && flock -n $LOCK sh -c "$VENV_PYTHON scripts/collect.py --market KOSPI --cache-root .cache --timeframes 1D 1h --no-smart-skip >> $LOG_DIR/collect_intraday.log 2>&1 && $VENV_PYTHON cli.py --strategy all --cache-root .cache --output-dir data --format signals_ui >> $LOG_DIR/signals_intraday.log 2>&1"

# Job C (실시간 현재가): 시장 지수 + 시그널 종목 현재가만 갱신 (2분 주기, 08:00-19:59)
*/2 8-19 * * 1-5 cd $APP_DIR && $VENV_PYTHON scripts/collect_live.py >> $LOG_DIR/live.log 2>&1

# Job C-EOD: 장 마감 후 네이버 API 의 fluctuationsRatio 정정값을 한 번 더 캐치.
# 15:30 마감 직전 마지막 Job C 실행분은 partial base 기반이라 +20% 같은 spike 가
# snapshot.json 에 freeze 될 수 있음. Job A (16:10) 와 직렬되도록 16:15·16:30 에 실행.
15,30 16 * * 1-5 cd $APP_DIR && $VENV_PYTHON scripts/collect_live.py >> $LOG_DIR/live.log 2>&1

# Job G + F (매주 토요일 02:00): WF 장기 이력 수집 → holding 추천 테이블 집계.
# && 체인이라 수집이 실패하면 집계는 돌지 않는다 (절반만 쓰인 .cache_wf 를 읽지 않게).
# Job G — --years 2: S6 는 주봉 80봉(일봉 760일), S7 은 매물대 200봉이 필요해 1년은 부족하다.
#   .cache manifest 의 1360 종목을 받으므로 2026-05 의 341 종목 10초보다 한참 오래 걸린다.
#   네트워크 상태에 따라 수 분대를 예상한다.
# Job F — data/holding_recommendations.json 은 git 미추적이라 이 잡이 없으면 그대로 낡는다.
#   --lookback-buffer-days 320: 기본 150 은 S6 기준이라 S7 이 조용히 빠진다.
#   날짜 인자는 주지 않는다. .cache_wf 에 실제로 담긴 구간을 스크립트가 알아서 쓴다.
0 2 * * 6 cd $APP_DIR && $VENV_PYTHON scripts/collect_wf_history.py --cache-root .cache --output-root .cache_wf --years 2 >> $LOG_DIR/wf_collect.log 2>&1 && $VENV_PYTHON scripts/aggregate_holding_recommendations.py --lookback-buffer-days 320 >> $LOG_DIR/holding_agg.log 2>&1
